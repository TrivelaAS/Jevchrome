{
  "manifest_version": 3,
  "name": "EXECUTER — pump.fun Exit Guardian",
  "version": "0.1.0",
  "description": "Ultra-MVP automated trade closer for pump.fun with Combo 2+4 trailing stop and time stop rules.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://pump.fun/*",
    "https://frontend-api.pump.fun/*",
    "https://api.jup.ag/*",
    "https://api.typesafe.ai/*",
    "https://api.dexscreener.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pump.fun/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EXECUTER",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
